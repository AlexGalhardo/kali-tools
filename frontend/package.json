{
  "name": "kali-tools-frontend",
  "private": true,
  "version": "0.6.0-dev.2",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/preserve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src && node scripts/check-wailsjs-imports.mjs",
    "format": "biome check --write src",
    "test": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lefthook": "2.2.2",
    "markdownlint": "0.42.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "katex": "0.19.0"
  },
  "license": "MIT",
  "author": "Alex Galhardo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGalhardo/kali-tools.git"
  },
  "bugs": {
    "url": "https://github.com/AlexGalhardo/kali-tools/issues"
  }
}
