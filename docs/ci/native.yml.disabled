name: Native build (dormant source)
on: [workflow_dispatch]
permissions:
  contents: read
jobs:
  desktop:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-2025, ubuntu-24.04, macos-15]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff
        with:
          go-version: 1.27.2
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24.20.0
      - if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libgtk-3-dev libwebkit2gtk-4.1-dev
      - run: npm install -g bun@1.4.3
      - run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.17.0
      - run: npm --prefix frontend ci
      - if: runner.os != 'Linux'
        run: wails build -tags desktop
      - if: runner.os == 'Linux'
        run: wails build -tags desktop,webkit2_41
      - run: go test -race -timeout 120s ./...
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: desktop-${{ matrix.os }}-unsigned-development
          path: build/bin/
