name: Checks (dormant source)
on: [push, pull_request]
permissions:
  contents: read
jobs:
  core:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff
        with:
          go-version: 1.27.2
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24.20.0
      - run: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
      - run: go install golang.org/x/vuln/cmd/govulncheck@v1.9.0
      - run: npm --prefix frontend ci
      - run: npx --prefix frontend playwright install --with-deps chromium
      - run: node scripts/task.mjs check
      - run: node scripts/task.mjs race
      - run: node scripts/task.mjs fuzz
      - run: node scripts/task.mjs workflows
      - run: node scripts/task.mjs lab
      - if: always()
        run: docker compose -f docker/compose.yml down --volumes --remove-orphans
